# PostgreSQL (Neon recommandé avec Vercel)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# AWS S3 — photos d'inscription
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-3
AWS_S3_BUCKET=var4-inscriptions

# URL publique des fichiers (optionnel — CloudFront ou domaine custom)
# Si vide : https://{bucket}.s3.{region}.amazonaws.com/{key}
AWS_S3_PUBLIC_BASE_URL=

# Google OAuth — bouton « S'inscrire avec Google » (Google Cloud Console)
# Type : Application Web — URI autorisée = https://votre-domaine (et http://localhost:3000 en dev)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# SMTP — formulaire de contact
SMTP_HOST=mail.miteka.io
SMTP_PORT=587
SMTP_USER=support@miteka.io
SMTP_PASSWORD=
SMTP_FROM=support@miteka.io
CONTACT_TO_EMAIL=duvirtuelaureel@miteka.io

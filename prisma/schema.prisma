generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Inscription {
  id            String   @id @default(cuid())
  fullName      String
  socialNetwork String
  link          String
  pseudo        String
  city          String
  email         String
  photoUrl      String?
  photoKey      String?
  createdAt     DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

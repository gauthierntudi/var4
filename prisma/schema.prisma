generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Inscription {
  id            String   @id @default(cuid())
  fullName      String
  socialNetwork String
  link          String
  pseudo        String
  city          String
  email         String
  photoUrl      String?
  photoKey      String?
  createdAt     DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

model Partner {
  id         String   @id @default(cuid())
  name       String
  websiteUrl String?
  logoUrl    String
  logoKey    String
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@index([createdAt])
}
